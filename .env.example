# Slip2Sure Application API Key (from https://app.slip2sure.com)
SLIP2SURE_API_KEY=your_slip2sure_api_key_here

# Optional HMAC secret & session timeouts for dashboard sessions
SESSION_SECRET=change_me_to_random_secret
# Session timeout (idle & access token TTL, e.g. 3600 = 1h, 30m, 2h)
SESSION_TIMEOUT=3600
# Refresh token TTL (e.g. 604800 = 7d, 30d)
REFRESH_TOKEN_TIMEOUT=604800

# Receiving Account Configuration
VITE_BANK_NAME=KBANK
VITE_BANK_ACCOUNT=123-4-56789-0
VITE_ACCOUNT_NAME=นายสมชาย ใจดี
VITE_PROMPTPAY_ID=0812345678
VITE_TRUEWALLET_ID=0812345678

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFsDEJrv5csefss-
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Database (optional). Empty = Cloudflare D1 (via wrangler.jsonc binding).
# Set a Postgres connection string to use Postgres instead of D1.
# With `docker compose up app postgres`, the bundled instance is at:
# POSTGRES_URL=postgresql://donate:donate@postgres:5432/donate
# POSTGRES_URL=postgresql://user:pass@host:5432/dbname

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Comma-separated list of OWNER Discord user IDs (required for owner login via Discord OAuth)
DISCORD_ALLOWED_USER_IDS=123456789012345678
# Optional: custom redirect URI (defaults to https://<host>/auth/discord/callback)
# DISCORD_REDIRECT_URI=https://donate-tools.detzz.workers.dev/auth/discord/callback
